# Sao chép thành .env trước khi chạy: cp .env.example .env
# Không commit .env.

# --- Service endpoints (giá trị mặc định dùng trong mạng nội bộ của compose) ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=cxr_images

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_local_only

# SQLite FTS: đường dẫn bên trong container
FTS_DB_PATH=/app/data/indexes/reports_fts.sqlite

# --- LLM query parser ---
# Mặc định: Ollama chạy native trên host Windows.
# Dùng profile local-llm thì đổi thành http://ollama:11434
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_TIMEOUT_SECONDS=20
# true = bỏ qua LLM, chỉ dùng rule-based parser
LLM_DISABLED=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Bắt buộc hiển thị trên UI
DISCLAIMER_TEXT=Research/education POC - not for diagnosis

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Đường dẫn dữ liệu trên host (bind-mount vào container ở chế độ read-only) ---
HOST_IMAGE_DIR=./data/processed/images

# --- Ingestion / worker ---
EMBEDDING_MODEL=microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DEVICE=cuda
HF_HOME=/app/.hf_cache

# --- Disk guard (GB) ---
DISK_MIN_FREE_GB=40
DISK_PROJECT_CEILING_GB=120
