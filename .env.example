# NOTE: the values below are for the Docker network (api/worker containers). For native
# runs (`uv run cxr index`, `validate-indexes`, `bench-vector`, a local uvicorn) either have no
# .env at all or override these five:
#   QDRANT_URL=http://localhost:6333
#   IMAGE_ROOT=data/raw/CheXpert-v1.0-small
#   CANONICAL_DIR=data/canonical
#   INDEXES_DIR=data/indexes
#   FTS_DB_PATH=data/indexes/report_search.sqlite
# A wrong FTS_DB_PATH disables the report index in the API (search answers without
# evidence; only a warning, a log line and /health say so) and makes `cxr eval-retrieval` exit 1,
# while `validate-indexes` still passes: it reads <--indexes-dir>/report_search.sqlite instead.
# Copy to .env before running: cp .env.example .env
# Never commit .env.

# --- Service endpoints (defaults are the compose-internal network) ---
QDRANT_URL=http://qdrant:6333
# The collection name is the build_id; this is only its prefix, so a stale
# index can never be served under a current build. See plan section 16.
QDRANT_COLLECTION_PREFIX=cxr_images

# --- Knowledge graph (docker compose --profile kg up -d neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Local default of compose.yaml; change it before exposing the port anywhere.
NEO4J_PASSWORD=cxr-local-neo4j

# --- Data paths inside the container ---
IMAGE_ROOT=/app/data/raw/CheXpert-v1.0-small
CANONICAL_DIR=/app/data/canonical
FTS_DB_PATH=/app/data/indexes/report_search.sqlite
INDEXES_DIR=/app/data/indexes
# Which registered build to serve (data/indexes/builds/<build_id>/manifest.json), and so which
# encoder. Leave blank to serve the only build of models.yaml:image_encoder.selected.
BUILD_ID=

# --- LLM query parser ---
# Default: Anthropic claude-haiku-5-5 from configs/models.yaml (WORKLOG D61); set these only to
# override it. LLM_PROVIDER=openai is any OpenAI-compatible API (LLM_BASE_URL, LLM_MODEL,
# LLM_API_KEY); LLM_PROVIDER=ollama with LLM_MODEL=qwen2.5:3b-instruct-q4_K_M and
# LLM_BASE_URL=http://host.docker.internal:11434 (http://ollama:11434 with the profile) runs offline.
LLM_PROVIDER=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# The Anthropic key (default provider) and the OpenAI-compatible key. Never commit a filled-in key.
ANTHROPIC_API_KEY=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
# true = skip the LLM and use the rule-based parser only
LLM_DISABLED=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Must be displayed in the UI
DISCLAIMER_TEXT=Research/education POC - not for diagnosis

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Embedding worker ---
# Filled in once the Phase 2 model gate picks a candidate.
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=64
# cpu is the portable default; compose.gpu.yaml overrides this to cuda.
EMBEDDING_DEVICE=cpu
HF_HOME=/app/.hf_cache
